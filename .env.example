# Optional local settings. Do not commit a real .env file or registration data.
# These values can also be configured in your hosting provider's dashboard.
PORT=3001
HOST=0.0.0.0
DATA_DIR=./data
# Set to 1 only when deployed behind one trusted reverse proxy (for example Render).
TRUST_PROXY=0
# On Render, render.yaml sets DATA_DIR=/var/data on a persistent disk.
